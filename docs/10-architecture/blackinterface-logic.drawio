<mxfile host="app.diagrams.net"><diagram id="main" name="Kiến trúc module"><mxGraphModel dx="900" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Black Interface — Kiến trúc module" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="15" width="500" height="30" as="geometry"/></mxCell><mxCell id="user" value="Vận hành viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="55" width="40" height="55" as="geometry"/></mxCell><mxCell id="fe" value="Frontend&#xa;&#xa;Giao diện web tại trạm: giám sát trạng thái,&#xa;sơ đồ SLD, cảnh báo/sự cố, cấu hình kỹ sư, hỏi đáp AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="400" height="75" as="geometry"/></mxCell><mxCell id="agent" value="BlackCore (agent/)&#xa;&#xa;Hội thoại NL: chọn tool, gọi API, trả lời kèm evidence&#xa;(dùng cùng API với UI — không quyền cao hơn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="200" height="75" as="geometry"/></mxCell><mxCell id="api" value="Domain API + Runtime&#xa;&#xa;REST endpoints + SSE push realtime&#xa;Quản lý subscription, fan-out tới nhiều client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="240" width="400" height="70" as="geometry"/></mxCell><mxCell id="dom" value="Domain — Neutral Station Model&#xa;&#xa;Logic deterministic: topology, mang điện, alarm/sự cố,&#xa;scope, evidence. Không biết NodeId OPC UA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=12;align=center;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="345" width="400" height="70" as="geometry"/></mxCell><mxCell id="diag" value="Diagram Engine&#xa;&#xa;Graph → layout → SVG&#xa;(SLD deterministic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="345" width="200" height="70" as="geometry"/></mxCell><mxCell id="integ" value="Integration Layer&#xa;&#xa;Đọc OPC UA read-only từ DataServer&#xa;Browse cấu trúc · subscribe giá trị · decode alarm&#xa;Map NodeId → model trung tính" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="450" width="400" height="80" as="geometry"/></mxCell><mxCell id="oneats" value="OneATS DataServer&#xa;(OPC UA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="565" width="220" height="45" as="geometry"/></mxCell><mxCell id="store" value="Store (SQLite)&#xa;Snapshot · cấu hình · hội thoại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="180" height="55" as="geometry"/></mxCell><mxCell id="ctrl" value="control/ — READ-ONLY&#xa;(đường ghi đóng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="180" height="40" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="user" target="fe"><mxGeometry r